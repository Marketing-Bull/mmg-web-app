{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://link.msgsndr.com https://*.msgsndr.com https://*.leadconnectorhq.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.public.blob.vercel-storage.com https://www.googletagmanager.com https://*.google-analytics.com https://*.msgsndr.com https://*.leadconnectorhq.com; media-src 'self' blob: https://*.public.blob.vercel-storage.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.msgsndr.com https://*.leadconnectorhq.com; frame-src 'self' https://*.msgsndr.com https://*.leadconnectorhq.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/content-manager.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/about-us/:path*", "destination": "/#about", "permanent": true },
    { "source": "/services/:path*", "destination": "/#marketing", "permanent": true },
    { "source": "/our-programs/:path*", "destination": "/#marketing", "permanent": true },
    { "source": "/practice-areas/:path*", "destination": "/#marketing", "permanent": true },
    { "source": "/events/:path*", "destination": "/#events", "permanent": true },
    { "source": "/activities/:path*", "destination": "/#events", "permanent": true },
    { "source": "/contact-us/:path*", "destination": "/#contact", "permanent": true },
    { "source": "/contact/:path*", "destination": "/#contact", "permanent": true },
    { "source": "/faq/:path*", "destination": "/faq.html", "permanent": true },
    { "source": "/home-2/:path*", "destination": "/", "permanent": true },
    { "source": "/attorneys/:path*", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/blog-landing-page-business-v1/:path*", "destination": "/", "permanent": true },
    { "source": "/privacy-policy/:path*", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/terms-of-service/:path*", "destination": "/terms-of-service.html", "permanent": true },
    { "source": "/disclaimer/:path*", "destination": "/disclaimer.html", "permanent": true },
    { "source": "/accessibility/:path*", "destination": "/accessibility.html", "permanent": true }
  ]
}
